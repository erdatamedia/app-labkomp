generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DOSEN
  WD2
  KAPRODI
  DEKAN
  MAHASISWA
}

enum BookingStatus {
  PENDING
  WD2_ACC
  APPROVED
  REJECTED
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      Role
  prodi     String?
  nip       String?
  noHp      String?
  jabatan   String?
  avatarUrl String?
  isActive     Boolean   @default(true)
  isApproved   Boolean   @default(false)
  registeredAt DateTime? @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  bookings  Booking[]
}

model AppSettings {
  id               String   @id @default("singleton")
  namaInstansi     String   @default("Universitas")
  namaFakultas     String   @default("Fakultas Teknik")
  namaJurusan      String   @default("Teknik Informatika")
  logoUrl          String?
  alamat           String?
  namaKepalaLab    String?
  nipKepalaLab     String?
  jabatanKepalaLab String?  @default("Kepala Laboratorium Komputer")
  updatedAt        DateTime @updatedAt
}

model Booking {
  id              Int      @id @default(autoincrement())
  userId          Int
  mataKuliah      String
  prodi           String
  hari            String
  jamMulai        DateTime
  jamSelesai      DateTime
  mingguMulai     Int
  mingguSelesai   Int
  software        String
  jumlahMahasiswa Int?

  jenisKegiatan   String   @default("KUL")
  namaLab         String   @default("Laboratorium Komputer")
  status          BookingStatus @default(PENDING)

  catatanAdmin    String?
  nomorSurat      String?
  tanggalSurat    DateTime?
  catatanWD2      String?
  isTTE           Boolean  @default(false)
  createdAt       DateTime @default(now())

  user            User @relation(fields: [userId], references: [id])
}